{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fcfcfb",
    "font": "Bricolage Grotesque",
    "view": {"stroke": null},
    "axis": {
      "labelFont": "Bricolage Grotesque",
      "titleFont": "Bricolage Grotesque",
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "domain": false,
      "ticks": false
    },
    "legend": {
      "labelFont": "Bricolage Grotesque",
      "titleFont": "Bricolage Grotesque",
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {"font": "Bricolage Grotesque", "color": "#0b0b0b"},
    "padding": {"left": 6, "right": 10, "top": 6, "bottom": 6}
  },
  "description": "Heatmap of school attendance rate by year level (rows) and calendar year (columns), 2014-2025, for a chosen state or territory. Darker cells mean higher attendance. No data was collected in 2020.",
  "title": {
    "text": {"expr": "'Attendance rate by year level and year, ' + state_select"},
    "subtitle": "All students, all sectors. Darker cells mean students attended more school days",
    "anchor": "start",
    "subtitleColor": "#52514e",
    "fontSize": 15,
    "offset": 12
  },
  "params": [
    {
      "name": "state_select",
      "value": "Australia",
      "bind": {
        "input": "select",
        "options": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "name": "State or territory: "
      }
    }
  ],
  "width": 540,
  "height": 320,
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "scale": {"domain": [2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025], "paddingInner": 0.06},
      "axis": {"orient": "top", "labelAngle": 0}
    }
  },
  "layer": [
    {
      "description": "Grey column for 2020, when no data was collected",
      "data": {"values": [{"year": 2020, "label": "No data collected"}]},
      "layer": [
        {"mark": {"type": "rect", "color": "#e1e0d9", "opacity": 0.6}},
        {
          "mark": {"type": "text", "angle": 270, "fontSize": 12, "color": "#52514e"},
          "encoding": {"text": {"field": "label"}, "y": {"value": 160}}
        }
      ]
    },
    {
      "data": {
        "url": "data/year_data.csv",
        "format": {"type": "csv", "parse": {"year": "number", "rate": "number"}}
      },
      "transform": [
        {"filter": "datum.state === state_select && datum.year_level !== 'Years 1-10' && isValid(datum.rate)"},
        {"calculate": "toNumber(replace(datum.year_level, 'Year ', ''))", "as": "level_num"}
      ],
      "encoding": {
        "y": {
          "field": "year_level",
          "type": "ordinal",
          "title": null,
          "sort": {"field": "level_num"},
          "scale": {"paddingInner": 0.06}
        }
      },
      "layer": [
        {
          "mark": {"type": "rect", "cornerRadius": 2},
          "encoding": {
            "color": {
              "field": "rate",
              "type": "quantitative",
              "title": "Attendance rate (%)",
              "scale": {"scheme": "blues", "zero": false},
              "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 240, "titleOrient": "left"}
            },
            "tooltip": [
              {"field": "state", "title": "State"},
              {"field": "year_level", "title": "Year level"},
              {"field": "year", "type": "ordinal", "title": "Year"},
              {"field": "rate", "type": "quantitative", "title": "Attendance rate (%)", "format": ".1f"}
            ]
          }
        }
      ]
    }
  ]
}
