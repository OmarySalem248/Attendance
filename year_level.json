{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fcfcfb",
    "font": "Bricolage Grotesque",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Bricolage Grotesque",
      "titleFont": "Bricolage Grotesque",
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "gridColor": "#e1e0d9",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "legend": {
      "labelFont": "Bricolage Grotesque",
      "titleFont": "Bricolage Grotesque",
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolSize": 110
    },
    "text": {
      "font": "Bricolage Grotesque",
      "color": "#0b0b0b"
    },
    "padding": {
      "left": 6,
      "right": 10,
      "top": 6,
      "bottom": 6
    }
  },
  "description": "Pictogram of 100 school days showing how many the average Australian student attends, for a chosen year level, averaged over 2014-2025.",
  "title": {
    "text": {"expr": "'Out of 100 school days, how many does the average ' + (year_select === 'Years 1-10' ? 'student' : year_select + ' student') + ' attend?'"},
    "subtitle": "Australia, all sectors, averaged over 2014-2025 (no data for 2020)",
    "anchor": "start"
  },
  "params": [
    {
      "name": "year_select",
      "value": "Years 1-10",
      "bind": {
        "input": "select",
        "options": ["Years 1-10", "Year 1", "Year 2", "Year 3", "Year 4", "Year 5", "Year 6", "Year 7", "Year 8", "Year 9", "Year 10"],
        "labels": ["All (Years 1-10)", "Year 1", "Year 2", "Year 3", "Year 4", "Year 5", "Year 6", "Year 7", "Year 8", "Year 9", "Year 10"],
        "name": "Year level: "
      }
    }
  ],
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/year_data.csv",
    "format": {"type": "csv", "parse": {"year": "number", "rate": "number"}}
  },
  "transform": [
    {"filter": "datum.state === 'Australia' && datum.year_level === year_select"},
    {
      "aggregate": [{"op": "mean", "field": "rate", "as": "avg_rate"}],
      "groupby": ["year_level"]
    },
    {"calculate": "round(datum.avg_rate)", "as": "days_attended"},
    {"calculate": "sequence(0, 100)", "as": "i"},
    {"flatten": ["i"]},
    {"calculate": "datum.i % 10", "as": "col"},
    {"calculate": "floor(datum.i / 10)", "as": "row"},
    {
      "calculate": "datum.i < datum.days_attended ? 'Days attended' : 'Days missed'",
      "as": "group"
    }
  ],
  "mark": {
    "type": "circle",
    "size": 520,
    "stroke": "#fcfcfb",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": ["Days attended", "Days missed"],
        "range": ["#2a78d6", "#eb6834"]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {"field": "year_level", "type": "nominal", "title": "Year level"},
      {"field": "group", "type": "nominal", "title": "Dot"},
      {"field": "avg_rate", "type": "quantitative", "title": "Average attendance rate (%)", "format": ".1f"}
    ]
  }
}
