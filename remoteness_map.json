{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {"expr": "'Remoteness area with the highest attendance, ' + year_select"},
    "subtitle": [
      "All students, Years 1-10, all sectors (no data collected in 2020)",
      "2014-15 use the older Metropolitan/Provincial/Remote areas"
    ],
    "frame": "bounds"
  },
  "width": 600,
  "height": 500,

  "params": [
    {
      "name": "year_select",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [2025, 2024, 2023, 2022, 2021, 2019, 2018, 2017, 2016, 2015, 2014],
        "name": "Year: "
      }
    }
  ],

  "data": {
    "url": "data/geo_data.csv",
    "format": {
      "type": "csv",
      "parse": {"year": "number", "rate": "number", "level": "number"}
    }
  },

  "projection": {"type": "mercator"},

  "transform": [
    {"filter": "datum.year === year_select"},
    {"calculate": "indexof(['Metropolitan', 'Major Cities', 'Inner Regional', 'Provincial', 'Outer Regional', 'Remote', 'Very Remote'], datum.geo)", "as": "geo_order"},
    {
      "window": [
        {"op": "row_number", "as": "rank"},
        {"op": "count", "as": "n_areas"},
        {"op": "lead", "field": "geo", "as": "second_geo"},
        {"op": "lead", "field": "rate", "as": "second_rate"}
      ],
      "sort": [{"field": "rate", "order": "descending"}, {"field": "geo_order", "order": "ascending"}],
      "groupby": ["state"],
      "frame": [null, null]
    },
    {"filter": "datum.rank === 1"},
    {"calculate": "datum.second_rate == null ? null : datum.rate - datum.second_rate", "as": "lead_pp"},
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "australian_states.geojson",
          "format": {"type": "json", "property": "features"}
        },
        "key": "properties.STATE_NAME"
      },
      "as": "shape"
    }
  ],

  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.75},

  "encoding": {
    "shape": {"field": "shape", "type": "geojson"},
    "color": {
      "field": "geo",
      "type": "nominal",
      "title": "Highest-attending area",
      "scale": {
        "domain": ["Metropolitan", "Major Cities", "Inner Regional", "Provincial", "Outer Regional", "Remote", "Very Remote"],
        "range": ["#CC79A7", "#0072B2", "#56B4E9", "#8C564B", "#009E73", "#E69F00", "#D55E00"]
      },
      "legend": {"orient": "bottom", "columns": 4, "titleLimit": 300}
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "geo", "type": "nominal", "title": "Highest-attending area"},
      {"field": "rate", "type": "quantitative", "title": "Attendance rate (%)", "format": ".1f"},
      {"field": "second_geo", "type": "nominal", "title": "Next highest area"},
      {"field": "second_rate", "type": "quantitative", "title": "Next highest rate (%)", "format": ".1f"},
      {"field": "lead_pp", "type": "quantitative", "title": "Lead (pp)", "format": ".1f"},
      {"field": "n_areas", "type": "quantitative", "title": "Areas reported"}
    ]
  }
}
